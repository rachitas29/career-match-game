# Example Database Configuration
# DATABASE_URL=postgres://user:password@hostname:port/database_name

# For local development with SQLite, leave DATABASE_URL empty or commented out.

# AES-256 Encryption Key for passwords — must be 64-char hex or 44-char base64
ENCRYPTION_KEY=your_64_character_hex_key_here

# JWT Secret for session tokens — use a strong random string (64+ chars recommended)
JWT_SECRET=your_strong_random_jwt_secret_here

# SendGrid API Key for password recovery emails
# SENDGRID_API_KEY=SG.your_key_here

# Sender email address (must be verified in SendGrid)
# FROM_EMAIL=noreply@yourdomain.com
